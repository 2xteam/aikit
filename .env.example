# 로컬 개발: 이 파일을 복사해 `.env.local` 로 저장한 뒤 값을 채우세요.
#
# ⚠️ Vercel 에는 **첫 Deploy 전에 전부** 넣어야 합니다. 환경 변수는 그 배포를
#    만들 때 스냅샷됩니다 — 나중에 추가해도 기존 배포는 모릅니다(재배포 필요).
#    → my-obsidian-vault / 30-Patterns/Vercel 배포 패턴.md

# ── MongoDB ────────────────────────────────────────────────────────────────
# 앱 데이터는 `aikit` DB, 회원은 `user` DB 를 공유한다.
#
# ⚠️ DB 이름은 URI 경로가 아니라 lib/db.ts 에 상수로 박혀 있다. `MONGO_DB` 같은
#    변수를 만들지 말 것 — 다른 앱의 .env.local 을 복사할 때 그 값이 따라와서
#    엉뚱한 DB 에 조용히 쓴다 (2026-09-04 TypeLog 33건 사고).
MONGO_URI=

# ── 세션 ───────────────────────────────────────────────────────────────────
# 다른 앱과 세션 공유.
# ⚠️ Vercel 에서는 **Secret 이 아니라 Config 타입**으로 등록할 것. Secret 으로 넣으면
#    브라우저 번들에 값이 안 박혀서 쿠키가 host-only 가 되고 앱 간 로그인이
#    조용히 끊긴다. 게다가 Secret 은 write-only 라 삭제 후 재등록해야 한다.
NEXT_PUBLIC_COOKIE_DOMAIN=.myjane.co.kr

# 세션 서명 토큰 검증 — 포털과 **같은 값**이어야 한다. 다르면 전부 401
SESSION_SECRET=

# 통합 admin 이 이 앱의 /api/admin/* 을 부를 때 쓰는 공유 비밀.
# 비어 있으면 관리 API 를 503 으로 막는다 (열어 두면 아무나 부른다)
ADMIN_API_SECRET=

# 통합 로그인 포털 (기본값 https://www.myjane.co.kr)
#
# ⚠️ 이 앱에는 로컬 로그인 화면이 없다. **로컬에서 로그인하려면 포털도 함께 띄우고**
#    아래를 http://localhost:3000 으로 둔다. 쿠키는 포트를 가리지 않으므로
#    localhost:3000 이 심은 세션을 localhost:3008 이 그대로 읽는다 → lib/portal.ts
NEXT_PUBLIC_PORTAL_ORIGIN=

# ── Cloudflare R2 (이미지 저장소) ──────────────────────────────────────────
# ⚠️ jangmini 와 **다른 버킷**이다. 여기는 사용자가 올린 사진이다.
# ⚠️ 버킷은 **비공개**다. Public Development URL 을 켜지 않는다. 그래서
#    R2_PUBLIC_URL 이 없다 — 이미지는 앱 라우트가 세션 확인 후 스트리밍한다.
# ⚠️ 다른 앱의 토큰을 복사해 쓰지 말 것. 계정·키 형식이 맞아 보이는데 그 버킷
#    범위가 아니라서 전부 403 이 나고, 원인을 찾기가 가장 어렵다.
#    → `npm run r2:check` 가 어디서 막히는지 알려준다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aikit

# ── 아직 안 씀 ─────────────────────────────────────────────────────────────
# 공유 동의 기록의 IP 해시 소금 (M3 에서 쓴다)
IP_HASH_SALT=

# 사진 분석 (M4). ⚠️ **AIKit 전용 프로젝트 키**를 쓰고 monthly hard limit 을 건다.
# 다른 앱과 키를 공유하면 여기서 어뷰징당할 때 그 앱들의 예산까지 태운다.
OPENAI_API_KEY=
